<UserControl x:Class="FlameEncoder.NodeEditor.Nodes.Controls.EnvironmentMapNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlameEncoder.NodeEditor.Nodes.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="170" d:DesignWidth="150" Height="170">
    <Grid>
        <StackPanel Margin="10 0">
            <TextBlock Text="Resolution:" Foreground="LightGray"/>
            <TextBox Name="widthBox" 
                     Background="#2a2a2a" 
                     Foreground="LightGray" 
                     TextChanged="widthBox_TextChanged" 
                     MouseDown="widthBox_MouseDown"
                     PreviewTextInput="widthBox_PreviewTextInput"/>
            <TextBlock Text="Skymap bit depth:" Foreground="LightGray"/>
            <ComboBox Name="skymap_bitdepth_Box" 
                     Background="#2a2a2a" 
                     Foreground="LightGray">
                <ComboBoxItem>
                    16 bit
                </ComboBoxItem>
                <ComboBoxItem>
                    32 bit
                </ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Specular bit depth:" Foreground="LightGray"/>
            <ComboBox Name="spec_bitdepth_Box" 
                     Background="#2a2a2a" 
                     Foreground="LightGray">
                <ComboBoxItem>
                    16 bit
                </ComboBoxItem>
                <ComboBoxItem>
                    32 bit
                </ComboBoxItem>
            </ComboBox>

            <TextBlock Text="Irradiance bit depth:" Foreground="LightGray"/>
            <ComboBox Name="irr_bitdepth_Box" 
                     Background="#2a2a2a" 
                     Foreground="LightGray">
                <ComboBoxItem>
                    16 bit
                </ComboBoxItem>
                <ComboBoxItem>
                    32 bit
                </ComboBoxItem>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
